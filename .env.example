# Optional live language-model integration.
# Leave OPENAI_API_KEY empty and keep MOCK_LLM=true to run fully offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6      # any model your account can access
MOCK_LLM=true

# Demo mode shows password-reset codes on screen (no email service yet).
# Set to false for any shared deployment.
FINLYTIC_SHOW_RESET_CODE=true

# Optional: persistent directory for auth.db and per-user databases.
# FINLYTIC_DATA_DIR=/var/lib/finlytic
